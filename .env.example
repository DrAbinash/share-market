# Copy to .env for local development. The deployment docs also reference this
# file — see DEPLOY-SYNOLOGY.md.

# SQLite database file. Docker sets this itself (see docker-compose.yml); this
# value is only used when running outside a container.
DATABASE_URL=file:./db/dev.db

# Host port published by docker compose. The container always listens on 3000.
APP_PORT=3080

# Market data provider.
#   auto      — try the live provider, fall back to the simulator (default)
#   live      — same as auto, but surfaces the failure reason in the API response
#   synthetic — never touch the network; always use the deterministic simulator
MARKET_DATA_PROVIDER=auto

# Milliseconds to wait for the live provider before falling back to the simulator.
MARKET_DATA_TIMEOUT_MS=4000
